#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &charybdis_6col_layout; };
};

&mt {
    quick-tap-ms = <170>;
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <170>;
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

// Layer definitions

#define QWERTY 0
#define FUNCTIONAL 1
#define SYMBOLS 2
#define GAMING 3
#define SNIPING 4

// #define SCROLL 5
// #define SNIPING 6
// #define GAMING 7

/ {
    behaviors {
        ts_snipe: trackball_snipe {
            compatible = "zmk,behavior-pointing-snipe";
            #binding-cells = <0>;
            velocity-multiplier = <4 1>;
        };

        ts_scroll: trackball_scroll {
            compatible = "zmk,behavior-pointing-scroll";
            #binding-cells = <0>;
            trigger-toggle;
        };

        game_dance_on: game_dance_on {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SEMI>, <&tog_game_on>;
        };

        game_dance_off: game_dance_off {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp SLASH>, <&tog_game_off>;
        };

        caps_dance: caps_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_DANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };

        td_shifr_caps: td_shifr_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFR_CAPS";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT LEFT_SHIFT>, <&kp CAPSLOCK>;

            tapping-term-ms = <200>;
        };

        brackets: brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        // Hold-tap behavior for layer with tap-preferred

        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        // Tap-dance for GUI/Ctrl+B

        gui_ctrlb: gui_ctrlb {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(B)>;
        };

        // Tap/hold Alt, double-tap Ctrl+Shift+Z

        lalt_dt: lalt_dt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LALT>, <&kp LC(LS(Z))>;
        };

        // Home row mods - Left hand

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55>; // Right side keys
            hold-trigger-on-release;
        };

        // Home row mods - Right hand

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52>; // Left side keys
            hold-trigger-on-release;
        };

        // RGB controls routed globally so split halves stay in sync.

        rgb_loc: rgbloc {
            compatible = "zmk,behavior-rgb-local";
            #binding-cells = <2>;
        };

        // RGB controls: dedicated direct bindings.
    };

    macros {
        tog_game_on: tog_game_on {
            compatible = "zmk,behavior-macro";
            label = "tog_game_on";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,100,50) &to 6>; // &amc AM_OFF 
        };

        tog_game_off: tog_game_off {
            compatible = "zmk,behavior-macro";
            label = "tog_game_off";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>; // &amc AM_ON 
        };

        // Ctrl+Alt+Cmd macro

        CAC: CAC {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &kp LGUI &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT &kp LGUI>;
        };

        // Ctrl+Shift+Alt macro

        CSA: CSA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LSHIFT &kp LALT>;
        };

        // Ctrl+Alt macro

        CA: CA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT>;
        };

        // Hold Ctrl+Cmd+Left Click while key is pressed (for mouse drag window actions)

        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LGUI &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &kp LCTRL &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <20>;
        require-prior-idle-ms = <250>;

        // Studio Unlock Combo - all three right thumb keys

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };

        // Gaming layer toggle combo - keys 49, 55, 54

        combo_gaming_toggle {
            timeout-ms = <50>;
            key-positions = <49 55 54>;
            bindings = <&tog GAMING>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        //    0             1             2             3             4             5                 11            10             9             8             7             6
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //   12            13            14            15            16            17                 23            22            21            20            19            18
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //   24            25            26            27            28            29                 35            34            33            32            31            30
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //   36            37            38            39            40            41                 47            46            45            44            43            42
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────╮
        //                  48            49            50            51            52                55            54            53
        //               ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
        //                                                                         Actual Key Positions
        //                                          ╭─────────────┬─────────────┬─────────────╮    ╭─────────────┬─────────────╮
        //                                             48            49            50                 54            53
        //                                          ╰─────────────┼─────────────┼─────────────┤    ├─────────────┼─────────────╯
        //                                                           51            52                 55
        //                                                        ╰─────────────┴─────────────╯    ╰─────────────╯

        qwerty_layer {
            label = "QWERTY";
            display-name = "Base";
            bindings = <
&kp ESC           &kp N1          &kp N2          &kp N3              &kp N4            &kp N5       &kp N6           &kp N7             &kp N8               &kp N9           &kp N0                   &kp BACKSPACE
&kp TAB           &kp Q           &kp W           &kp E               &kp R             &kp T        &kp Y            &kp U              &kp I                &kp O            &kp P                    &brackets
&td_shifr_caps    &mt LEFT_WIN A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G        &kp H            &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &mt RIGHT_WIN SEMICOLON  &kp APOS
&kp LEFT_CONTROL  &kp Z           &kp X           &kp C               &kp V             &kp B        &kp N            &kp M              &kp COMMA            &kp DOT          &kp FSLH                 &kp BACKSLASH
                                                  &mkp LCLK           &mkp MCLK         &mkp RCLK    &kp ENTER        &kp SPACE
                                                                      &kp SPACE         &mo 1        &mt EQUAL MINUS
            >;
        };

        functional_layer {
            label = "FUNCTIONAL";
            display-name = "Functional";
            bindings = <
&kp F1  &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7      &kp F8          &kp F9          &kp F10          &kp F11     &kp F12
&trans  &none         &none         &none         &none         &none           &none       &kp HOME        &kp UP_ARROW    &kp PAGE_UP      &none       &kp C_VOLUME_UP
&trans  &to 2         &to 3         &to 4         &to 5         &to 6           &none       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp INSERT  &kp C_VOLUME_DOWN
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &kp END         &kp RIGHT_ALT   &kp PAGE_DOWN    &kp DELETE  &none
                                    &trans        &trans        &trans          &trans      &trans
                                                  &trans        &trans          &trans
            >;
        };

        symbols_layer {
            label = "SYMBOLS";
            display-name = "Symbols";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT              &kp HOME       &kp GRAVE          &kp TILDE          &kp RIGHT_WIN  &kp RIGHT_ALT  &kp BACKSPACE
&trans  &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp END        &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp SEMICOLON  &kp COLON      &kp SQT
&trans  &kp MINUS        &kp EQUAL      &kp PLUS      &kp LESS_THAN         &kp GREATER_THAN         &kp PAGE_UP    &kp DOUBLE_QUOTES  &kp COMMA          &kp PERIOD     &kp QMARK      &kp BACKSLASH
&trans  &kp UNDERSCORE   &kp PIPE       &kp SLASH     &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp PAGE_DOWN  &kp ESCAPE         &kp ENTER          &kp SPACE      &kp DELETE     &kp INSERT
                                        &trans        &trans                &trans                   &trans         &trans
                                                      &trans                &to 0                    &trans
            >;
        };

        gaming_layer {
            label = "GAMING";
            display-name = "Gaming";
            bindings = <
&kp ESC       &kp GRAVE         &kp N1  &kp N2     &kp N3     &kp N4       &kp N5        &kp N6     &kp N7  &kp N8     &kp N9      &kp N0
&kp MINUS     &kp TAB           &kp Q   &kp W      &kp E      &kp R        &kp T         &kp Y      &kp U   &kp I      &kp O       &kp P
&kp EQUAL     &caps_dance       &kp A   &kp S      &kp D      &kp F        &kp G         &kp H      &kp J   &kp K      &kp L       &kp SEMICOLON
&kp LEFT_WIN  &kp LEFT_CONTROL  &kp Z   &kp X      &kp C      &kp V        &kp B         &kp N      &kp M   &kp COMMA  &kp PERIOD  &game_dance_off
                                        &mkp LCLK  &mkp MCLK  &mkp RCLK    &kp ENTER     &kp SPACE
                                                   &mkp MB4   &mkp MB5     &kp LEFT_ALT
            >;
        };

        sniping_layer {
            label = "SNIPING";
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 1   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans     &trans  &trans
                        &trans  &trans  &trans    &mkp MB4  &mkp MB5
                                &trans  &trans    &to 0
            >;
        };

        //    scroll_layer {
        //      label = "SCROLL";
        //      display-name = "Scroll";
        //      bindings = <
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────╮
        //                  &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans
        //               ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
        //      >;
        //    };
        //    sniping_layer {
        //      label = "SNIPING";
        //      display-name = "Sniping";
        //      bindings = <
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &trans        &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans        &trans
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────╮
        //                  &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans
        //               ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
        //      >;
        //    };
        //    gaming_layer {
        //      label = "GAMING";
        //      display-name = "Gaming";
        //      bindings = <
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        //    &kp ESC       &kp N1       &kp N2        &kp N3        &kp N4        &kp N5            &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp DEL
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &kp T        &kp TAB       &kp Q         &kp W         &kp E         &kp R             &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSLH
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &kp G        &kp LSFT      &kp A         &kp S         &kp D         &kp F             &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        //    &kp B        &kp LCTRL     &kp Z         &kp X         &kp C         &kp V             &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RSFT
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────╮
        //                  &trans        &trans        &kp SPACE     &trans        &trans            &trans        &trans        &trans
        //               ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
        //      >;
        //    };
    };
};
